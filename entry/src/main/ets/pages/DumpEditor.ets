/**
 * A simple hex editor for showing and editing tag dumps generated by the
 * ReadTag page (port of de.syss.MifareClassicTool.Activities.DumpEditor,
 * GPL-3.0, Gerhard Klostermeier).
 *
 * Features (like the Android original):
 * - Color: keys (A/B), Access Conditions, Value Blocks, UID & Manuf. Info
 * - Save dump to file (with file name dialog and replace/append conflict
 *   handling)
 * - Save keys from all sector trailers to a key file
 * - Display dump as US-ASCII (hexToAscii)
 * - Display Access Conditions as table (acDecoder)
 * - Resolve Value Blocks to integers (valueBlocksToInt)
 * - Decode date of manufacture (BCD in manufacturer block)
 * - Write dump (writeTag), compare dump (diffTool)
 * - Share dump, export dump (importExportTool), copy all sectors
 * - Open Value Block / Access Condition / BCC tools
 *
 * Editing/coloring approach: the Android editor uses one editable,
 * multi-line EditText per sector with span-based coloring (text typed
 * by the user is uncolored until "Update Colors" re-initializes the
 * editor). This port renders one centered sector block per sector:
 * colored, span-based Text lines; tapping a sector's data opens one
 * inline, multi-line TextArea for the whole sector (4/16 lines).
 * Newly typed text stays uncolored until "Update Colors", exactly
 * like the Android editor.
 */

import { MctDialog, MctInputDialog } from '../common/ui/MctDialog';
import { display } from '@kit.ArkUI';
import { MctTheme } from '../common/ui/MctTheme';
import { HexUtils } from '../common/HexUtils';
import { MctFiles } from '../common/MctFiles';
import { MifareUtils } from '../common/MifareUtils';
import { NfcService } from '../common/NfcService';
import { AcDecoderParams } from './AcDecoder';
import { DiffToolParams } from './DiffTool';
import { HexToAsciiParams } from './HexToAscii';
import { ImportExportToolParams } from './ImportExportTool';
import { ValueBlocksToIntParams } from './ValueBlocksToInt';
import { WriteTagParams } from './WriteTag';

/** Params for the dump editor page. */
export class DumpEditorParams {
  dump: string[] | null = null;
  chosenFile: string = '';
}

/** Kind of a dump editor line. */
enum DumpEditorLineKind {
  Data,
  Header,
  Error
}

/** Render model for one line of the dump editor. */
class DumpEditorLineInfo {
  kind: DumpEditorLineKind = DumpEditorLineKind.Data;
  text: string = '';
  isRealHeader: boolean = false;
  isUidBlock: boolean = false;
  isValueBlock: boolean = false;
  isSectorTrailer: boolean = false;
  segKeyA: string = '';
  segAc: string = '';
  segGpb: string = '';
  segKeyB: string = '';
}

/** Sector group: one sector header plus its data lines or error line. */
class DumpEditorSectorGroup {
  sectorNumber: string = '';
  headerIndex: number = -1;
  errorIndex: number = -1;
  dataIndexes: number[] = [];
}

/** Error text for the date of manufacture dialog (dialog_date_of_manuf_error). */
const DUMP_EDITOR_MANUF_ERROR_TEXT: string =
  '制造日期包含无效数据。'
  + '\n\n制造商块的最后 2 个字节应采用二进制编码的十进制'
  + '（BCD）格式（仅数字，无字母）。第一个字节（制造周数）必须介于 1 到 53 之间'
  + '（例如 28）。第二个字节（制造年份）必须介于 0 到当前年份之间'
  + '（例如 12，即 2012 年）。'
  + '\n\n该标签可能不是原装的 MIFARE Classic 标签。';

/** Extract the file name (last path segment) of a full path. */
function dumpEditorBaseName(path: string): string {
  const idx: number = path.lastIndexOf('/');
  if (idx === -1) {
    return path;
  }
  return path.substring(idx + 1);
}

/** Format the current date/time as "yyyy-MM-dd_HH-mm-ss" (local time). */
function dumpEditorTimestamp(): string {
  const now: Date = new Date();
  const pad = (n: number): string => (n < 10 ? '0' : '') + n.toString();
  return now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-'
    + pad(now.getDate()) + '_' + pad(now.getHours()) + '-'
    + pad(now.getMinutes()) + '-' + pad(now.getSeconds());
}

/** Format a date as "dd.MM.yyyy" (like SimpleDateFormat in the Java code). */
function dumpEditorFormatDate(d: Date): string {
  const pad = (n: number): string => (n < 10 ? '0' : '') + n.toString();
  return pad(d.getDate()) + '.' + pad(d.getMonth() + 1) + '.' + d.getFullYear();
}

@Component
struct DumpEditorPage {
  @State lineInfos: DumpEditorLineInfo[] = [];
  @State navTitle: string = '转储编辑器';
  @State sectorGroups: DumpEditorSectorGroup[] = [];
  @State editText: string = '';
  @State editKey: string = '';
  private editDirty: boolean = false;
  private groupsVersion: number = 0;
  private dataWidth: number = 272;
  private dataLineHeight: number = 22;
  /** UI scale: reproduces the reference app proportions (a 360vp wide
   * screen with 14sp editor fonts, 18.9vp line pitch) on any screen. */
  private uiScale: number = 1;
  private dataFont: number = 14;
  private headerFont: number = 14;
  private captionFont: number = 14;
  private titleFont: number = 20;
  private headerGap: number = 13;
  private groupGap: number = 8.5;
  private pathStack: NavPathStack = new NavPathStack();
  private dialogCtrl: CustomDialogController | null = null;
  /** Validated lines (updated by every checkDumpAndUpdateLines() check). */
  private mLines: string[] = [];
  private dumpName: string | null = null;
  private keysName: string | null = null;
  private uid: string | null = null;
  /** True if the user made changes to the dump (save before quitting). */
  private dumpChanged: boolean = false;
  /** If true, the editor will close after a successful save. */
  private closeAfterSuccessfulSave: boolean = false;

  aboutToAppear(): void {
    MctTheme.refresh();
    // Compute the UI scale from the screen width: the reference app
    // renders 14sp editor fonts on a 360vp wide screen. Scaling all
    // editor font sizes and gaps by (screenVp / 360) reproduces its
    // text-to-screen proportions on any device (and degrades to the
    // exact Android values on a 360vp phone).
    try {
      const disp: display.Display = display.getDefaultDisplaySync();
      const screenVp: number = disp.width / disp.densityPixels;
      this.uiScale = Math.min(1.75, Math.max(1.0, screenVp / 360));
    } catch (e) {
      // Keep the default scale.
    }
    this.dataFont = 14 * this.uiScale;
    this.headerFont = 14 * this.uiScale;
    this.captionFont = 14 * this.uiScale;
    this.titleFont = 20 * this.uiScale;
    this.dataLineHeight = 18.9 * this.uiScale;
    this.headerGap = 13 * this.uiScale;
    this.groupGap = 8.5 * this.uiScale;
    // Measure the width of a 32 char monospace block line (used to
    // size the inline sector editor like the Android wrap_content
    // EditText).
    const w: number = this.getUIContext().getMeasureUtils().measureText({
      textContent: 'FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF',
      fontSize: this.dataFont,
      fontFamily: 'monospace'
    });
    if (w > 0) {
      this.dataWidth = this.getUIContext().px2vp(w) + 8;
    }
  }

  // ---------------- Init ----------------

  /**
   * Initialize the editor with the given lines. If the lines do not
   * contain a valid dump, an error toast will be shown and the page
   * exits (initEditor of the Android DumpEditor).
   */
  private initEditor(lines: string[] | null): void {
    const err: number = MifareUtils.isValidDump(lines, true);
    if (err !== 0) {
      this.isValidDumpErrorToast(err);
      NfcService.toast('错误：数据对此编辑器无效', true);
      this.pathStack.pop();
      return;
    }
    this.rebuildLineInfos(lines);
  }

  /**
   * Parse the dump lines and build the render model (coloring) for
   * the editor (the coloring part of the Android initEditor).
   */
  private rebuildLineInfos(lines: string[] | null): void {
    const infos: DumpEditorLineInfo[] = [];
    if (lines === null || lines === undefined) {
      this.lineInfos = infos;
      return;
    }
    let isFirstBlock: boolean = false;
    for (let i = 0; i < lines.length; i++) {
      const line: string = lines[i];
      if (line.startsWith('+')) {
        // Line is a header.
        isFirstBlock = line.endsWith(' 0');
        const info = new DumpEditorLineInfo();
        info.kind = DumpEditorLineKind.Header;
        const parts: string[] = line.split(': ');
        info.text = '扇区: ' + (parts.length === 2 ? parts[1] : '');
        // Only headers of real sectors (with data, not with an error
        // line ("*") following) are "real" headers.
        info.isRealHeader = i + 1 !== lines.length && !lines[i + 1].startsWith('*');
        infos.push(info);
      } else if (line.startsWith('*')) {
        // Error line: sector that could not be read.
        const info = new DumpEditorLineInfo();
        info.kind = DumpEditorLineKind.Error;
        info.text = '   未找到密钥（或扇区已损坏）';
        infos.push(info);
      } else {
        // Line is a block.
        const info = new DumpEditorLineInfo();
        info.kind = DumpEditorLineKind.Data;
        info.text = line;
        if (i + 1 === lines.length || lines[i + 1].startsWith('+')) {
          // Line is a sector trailer.
          info.isSectorTrailer = true;
          if (line.length >= 32) {
            // colorSectorTrailer: KeyA | ACs | GPB (not colored) | KeyB.
            info.segKeyA = line.substring(0, 12);
            info.segAc = line.substring(12, 18);
            info.segGpb = line.substring(18, 20);
            info.segKeyB = line.substring(20);
          }
        } else {
          // Data block (with UID coloring for the first block
          // of the entire tag).
          info.isUidBlock = isFirstBlock;
          isFirstBlock = false;
          if (!info.isUidBlock) {
            info.isValueBlock = MifareUtils.isValueBlock(line);
          }
        }
        infos.push(info);
      }
    }
    this.lineInfos = infos;
    this.rebuildSectorGroups();
  }

  /**
   * Group the line infos by sector (one group per "+Sector" header).
   * The groups are the render model of the editor UI (one editable
   * block per sector, like the Android editor's per-sector EditText).
   */
  private rebuildSectorGroups(): void {
    const groups: DumpEditorSectorGroup[] = [];
    let current: DumpEditorSectorGroup | null = null;
    for (let i = 0; i < this.lineInfos.length; i++) {
      const info = this.lineInfos[i];
      if (info.kind === DumpEditorLineKind.Header) {
        current = new DumpEditorSectorGroup();
        current.headerIndex = i;
        const parts: string[] = info.text.split(': ');
        current.sectorNumber = parts.length === 2 ? parts[1] : '';
        groups.push(current);
      } else if (info.kind === DumpEditorLineKind.Error) {
        if (current !== null) {
          current.errorIndex = i;
        }
      } else {
        if (current === null) {
          // Defensive: data line without a preceding sector header.
          current = new DumpEditorSectorGroup();
          current.headerIndex = -1;
          groups.push(current);
        }
        current.dataIndexes.push(i);
      }
    }
    this.groupsVersion = this.groupsVersion + 1;
    this.sectorGroups = groups;
  }

  /**
   * Check if all sectors contain valid data. If all blocks are O.K.
   * mLines will be updated (checkDumpAndUpdateLines of the Android
   * DumpEditor).
   * Returns 0 (O.K.), 1 (not 4 or 16 blocks), 2 (invalid characters),
   * 3 (not 32 chars).
   */
  private checkDumpAndUpdateLines(): number {
    // Commit a pending inline edit first, so the check (and all
    // actions based on it) sees the current editor content.
    this.commitPendingEdit();
    const checkedLines: string[] = [];
    let blocksSinceRealHeader: number = 0;
    let seenRealHeader: boolean = false;
    for (let i = 0; i < this.lineInfos.length; i++) {
      const info = this.lineInfos[i];
      if (info.kind === DumpEditorLineKind.Header) {
        if (info.isRealHeader) {
          if (seenRealHeader && blocksSinceRealHeader !== 4
            && blocksSinceRealHeader !== 16) {
            // Not 4 or 16 blocks.
            return 1;
          }
          const parts: string[] = info.text.split(': ');
          checkedLines.push('+Sector: ' + (parts.length === 2 ? parts[1] : ''));
          seenRealHeader = true;
          blocksSinceRealHeader = 0;
        }
      } else if (info.kind === DumpEditorLineKind.Data) {
        const line: string = info.text;
        // Is hex or "-" == NO_KEY or NO_DATA.
        if (!/^[0-9A-Fa-f-]+$/.test(line)) {
          // Not pure hex.
          return 2;
        }
        if (line.length !== 32) {
          // Not 32 chars per line.
          return 3;
        }
        checkedLines.push(line.toUpperCase());
        blocksSinceRealHeader++;
      }
    }
    if (seenRealHeader && blocksSinceRealHeader !== 4
      && blocksSinceRealHeader !== 16) {
      return 1;
    }
    // Update mLines.
    this.mLines = checkedLines;
    return 0;
  }

  /**
   * Update the coloring (onUpdateColors of the Android DumpEditor).
   * The colors are updated if all data are valid
   * (checkDumpAndUpdateLines()).
   */
  private onUpdateColors(): void {
    const err: number = this.checkDumpAndUpdateLines();
    if (err !== 0) {
      this.isValidDumpErrorToast(err);
      return;
    }
    // Re-initialize the whole editor (like the Android method does).
    this.rebuildLineInfos(this.mLines);
  }

  /**
   * Show a toast with error information according to
   * Common.isValidDumpErrorToast.
   */
  private isValidDumpErrorToast(errorCode: number): void {
    if (errorCode === 1) {
      NfcService.toast('错误：部分扇区的块（行）数不是 4 或 16', true);
    } else if (errorCode === 2) {
      NfcService.toast('错误：部分块包含无效数据（非十六进制）', true);
    } else if (errorCode === 3) {
      NfcService.toast('错误：部分块不足 16 字节（32 个字符）', true);
    } else if (errorCode === 4) {
      NfcService.toast('错误：扇区超出范围（< 0 或 > 39）', true);
    } else if (errorCode === 5) {
      NfcService.toast('错误：同一扇区号出现多次', true);
    } else if (errorCode === 6) {
      NfcService.toast('错误：转储为空', true);
    }
  }

  // ---------------- Editing ----------------

  /**
   * Open the inline editor for one sector's data (the Android editor
   * has one editable, multi-line EditText per sector).
   */
  private startEditing(sectorNumber: string): void {
    if (this.editKey === sectorNumber) {
      return;
    }
    this.commitPendingEdit();
    for (let i = 0; i < this.sectorGroups.length; i++) {
      const group = this.sectorGroups[i];
      if (group.sectorNumber === sectorNumber && group.dataIndexes.length > 0) {
        const texts: string[] = [];
        for (let j = 0; j < group.dataIndexes.length; j++) {
          texts.push(this.lineInfos[group.dataIndexes[j]].text);
        }
        this.editText = texts.join('\n');
        this.editKey = sectorNumber;
        this.editDirty = false;
        return;
      }
    }
  }

  /**
   * Commit the pending inline sector edit: replace the sector's data
   * lines with the edited text. The new lines are uncolored, exactly
   * like text typed into the Android EditText, which only gets its
   * coloring back via "Update Colors".
   */
  private commitPendingEdit(): void {
    if (this.editKey.length === 0) {
      return;
    }
    const key: string = this.editKey;
    const wasDirty: boolean = this.editDirty;
    this.editKey = '';
    this.editDirty = false;
    if (!wasDirty) {
      // Nothing was changed. Keep the colored lines.
      return;
    }
    for (let i = 0; i < this.sectorGroups.length; i++) {
      const group = this.sectorGroups[i];
      if (group.sectorNumber === key && group.headerIndex >= 0
        && group.dataIndexes.length > 0) {
        const newLines: string[] =
          this.editText.replace(/\r/g, '').split('\n');
        const newInfos: DumpEditorLineInfo[] = [];
        for (let j = 0; j < newLines.length; j++) {
          const info = new DumpEditorLineInfo();
          info.kind = DumpEditorLineKind.Data;
          info.text = newLines[j];
          newInfos.push(info);
        }
        const first: number = group.headerIndex + 1;
        const last: number = group.headerIndex + group.dataIndexes.length;
        const updated: DumpEditorLineInfo[] = this.lineInfos.slice(0, first)
          .concat(newInfos).concat(this.lineInfos.slice(last + 1));
        this.lineInfos = updated;
        this.rebuildSectorGroups();
        return;
      }
    }
  }

  // ---------------- Save ----------------

  /**
   * Check if it is a valid dump (checkDumpAndUpdateLines()), create a
   * file name suggestion and call saveFile() (saveDump of the Android
   * DumpEditor).
   */
  private saveDump(): void {
    const err: number = this.checkDumpAndUpdateLines();
    if (err !== 0) {
      this.isValidDumpErrorToast(err);
      return;
    }
    // Set a filename (UID + Date + Time) if there is none.
    if (this.dumpName === null) {
      this.dumpName = 'UID_' + (this.uid ?? 'null') + '_'
        + dumpEditorTimestamp() + '.mct';
    }
    this.saveFile(this.mLines, this.dumpName, true,
      '保存转储', '输入转储的文件名：');
  }

  /**
   * Check if it is a valid dump (checkDumpAndUpdateLines()), extract
   * all keys from the current dump, create a file name suggestion and
   * call saveFile() (saveKeys of the Android DumpEditor).
   */
  private saveKeys(): void {
    const err: number = this.checkDumpAndUpdateLines();
    if (err !== 0) {
      this.isValidDumpErrorToast(err);
      return;
    }
    // Get all keys (skip Data and ACs).
    const tmpKeys = new Set<string>();
    for (let i = 0; i < this.mLines.length; i++) {
      if (i + 1 === this.mLines.length || this.mLines[i + 1].startsWith('+')) {
        // Sector trailer.
        const keyA: string = this.mLines[i].substring(0, 12).toUpperCase();
        const keyB: string = this.mLines[i].substring(20).toUpperCase();
        if (keyA !== MifareUtils.NO_KEY) {
          tmpKeys.add(keyA);
        }
        if (keyB !== MifareUtils.NO_KEY) {
          tmpKeys.add(keyB);
        }
      }
    }
    const keys: string[] = [];
    tmpKeys.forEach((k: string): void => {
      keys.push(k);
    });

    // Set the filename to the UID if there is none.
    if (this.keysName === null) {
      if (this.dumpName === null) {
        this.keysName = 'UID_' + (this.uid ?? 'null');
      } else {
        this.keysName = this.dumpName ?? 'null';
      }
    }
    this.keysName = this.keysName + '.keys';

    this.saveFile(keys, this.keysName, false,
      '保存密钥文件', '输入密钥文件的文件名：');
  }

  /**
   * Ask user for a save name and then call
   * checkFileExistenceAndSave() (saveFile of the Android DumpEditor).
   * This is a helper function for saveDump() and saveKeys().
   */
  private saveFile(data: string[], fileName: string, isDump: boolean,
    title: string, message: string): void {
    const targetDir: string = isDump
      ? MctFiles.getDumpsDir() : MctFiles.getKeysDir();
    // If the dialog is cancelled (negative button), the Android code
    // resets mCloseAfterSuccessfulSave. Prepare for that and restore
    // the old value if the user confirms.
    const wasCloseAfterSuccessfulSave: boolean = this.closeAfterSuccessfulSave;
    this.closeAfterSuccessfulSave = false;
    this.dialogCtrl = new CustomDialogController({
      builder: MctInputDialog({
        titleText: title,
        messageText: message,
        inputInitial: fileName,
        inputPlaceholder: '',
        cancelButtonText: '取消',
        confirmButtonText: '保存',
        onConfirm: (text: string): void => {
          this.closeAfterSuccessfulSave = wasCloseAfterSuccessfulSave;
          if (text.length > 0 && text.indexOf('/') === -1) {
            this.checkFileExistenceAndSave(targetDir + '/' + text, data, isDump);
            if (isDump) {
              this.dumpName = text;
            } else {
              this.keysName = text;
            }
          } else {
            // Invalid file name.
            NfcService.toast('错误：文件名无效', true);
          }
        }
      }),
      alignment: DialogAlignment.Center,
      autoCancel: true,
      customStyle: true
    });
    this.dialogCtrl.open();
    this.onUpdateColors();
  }

  /**
   * Check if the file already exists. If so, present a dialog to the
   * user with the options: "Replace", "Append" and "Cancel"
   * (Common.checkFileExistenceAndSave).
   */
  private checkFileExistenceAndSave(path: string, lines: string[],
    isDump: boolean): void {
    if (MctFiles.exists(path)) {
      // Save conflict for dump file or key file?
      const message: string = isDump
        ? '该文件已存在。您想如何处理？\n\n'
          + '注意：包含多个转储的文件（通过“追加”创建）'
          + '无法在此应用中显示、编辑或写入。'
        : '该文件已存在。您想如何处理？';
      this.dialogCtrl = new CustomDialogController({
        builder: MctDialog({
          titleText: '文件已存在',
          messageText: message,
          button1Text: '替换',
          button1Action: (checked: boolean): void => {
            // Replace.
            if (MctFiles.writeLines(path, lines)) {
              NfcService.toast('数据保存成功', true);
              this.onSaveSuccessful();
            } else {
              NfcService.toast('错误：保存数据时出错', true);
              this.onSaveFailure();
            }
          },
          button3Text: '追加',
          button3Action: (checked: boolean): void => {
            // Append.
            if (lines.length > 0 && MctFiles.appendLines(path, lines, isDump)) {
              NfcService.toast('数据保存成功', true);
              this.onSaveSuccessful();
            } else {
              NfcService.toast('错误：保存数据时出错', true);
              this.onSaveFailure();
            }
          },
          button2Text: '取消',
          button2Action: (checked: boolean): void => {
            // Cancel.
            this.onSaveFailure();
          }
        }),
        alignment: DialogAlignment.Center,
        autoCancel: true,
        customStyle: true
      });
      this.dialogCtrl.open();
    } else {
      if (MctFiles.writeLines(path, lines)) {
        NfcService.toast('数据保存成功', true);
        this.onSaveSuccessful();
      } else {
        NfcService.toast('错误：保存数据时出错', true);
        this.onSaveFailure();
      }
    }
  }

  /**
   * Close the editor if closeAfterSuccessfulSave is true (due to
   * exiting with unsaved changes) after a successful save process
   * (onSaveSuccessful of IActivityThatReactsToSave).
   */
  private onSaveSuccessful(): void {
    if (this.closeAfterSuccessfulSave) {
      this.pathStack.pop();
    }
    this.dumpChanged = false;
  }

  /**
   * Reset the state of closeAfterSuccessfulSave if there was an error
   * (or if the user hit cancel) during the save process
   * (onSaveFailure of IActivityThatReactsToSave).
   */
  private onSaveFailure(): void {
    this.closeAfterSuccessfulSave = false;
  }

  /**
   * The dump will be checked and stored in the tmp directory
   * (saveDumpToTemp of the Android DumpEditor).
   * Returns the temporary dump file path or null.
   */
  private saveDumpToTemp(): string | null {
    const err: number = this.checkDumpAndUpdateLines();
    if (err !== 0) {
      this.isValidDumpErrorToast(err);
      return null;
    }
    // Save dump to a temporary file which will be attached for
    // sharing (and stored in the tmp folder).
    let fileName: string;
    if (this.dumpName === null) {
      // The dump has no name. Use date and time as name.
      fileName = dumpEditorTimestamp();
    } else {
      fileName = this.dumpName;
    }
    // Save file to tmp directory.
    const file: string = MctFiles.getFile(MctFiles.TMP_DIR + '/' + fileName);
    if (!MctFiles.writeLines(file, this.mLines)) {
      NfcService.toast('错误：保存数据时出错', true);
      return null;
    }
    return file;
  }

  // ---------------- Tools ----------------

  /**
   * Display the hex data as US-ASCII (showAscii of the Android
   * DumpEditor). Pushes the hexToAscii page.
   */
  private showAscii(): void {
    const err: number = this.checkDumpAndUpdateLines();
    if (err !== 0) {
      this.isValidDumpErrorToast(err);
      return;
    }
    // Get all data blocks (skip all Access Conditions).
    const tmpDump: string[] = [];
    for (let i = 0; i < this.mLines.length - 1; i++) {
      if (i + 1 !== this.mLines.length
        && !this.mLines[i + 1].startsWith('+')) {
        tmpDump.push(this.mLines[i]);
      }
    }
    const params = new HexToAsciiParams();
    params.dump = tmpDump;
    this.pathStack.pushPathByName('hexToAscii', params);
  }

  /**
   * Display the access conditions (showAC of the Android DumpEditor).
   * Pushes the acDecoder page.
   */
  private showAC(): void {
    const err: number = this.checkDumpAndUpdateLines();
    if (err !== 0) {
      this.isValidDumpErrorToast(err);
      return;
    }
    // Get all Access Conditions (skip Data).
    const tmpACs: string[] = [];
    let lastSectorHeader: number = 0;
    for (let i = 0; i < this.mLines.length; i++) {
      if (this.mLines[i].startsWith('+')) {
        // Header.
        tmpACs.push(this.mLines[i]);
        lastSectorHeader = i;
      } else if (i + 1 === this.mLines.length
        || this.mLines[i + 1].startsWith('+')) {
        // Access Condition.
        if (i - lastSectorHeader > 4) {
          // Access Conditions of a sector with more than 4 blocks
          // --> Mark ACs with "*".
          tmpACs.push('*' + this.mLines[i].substring(12, 20));
        } else {
          tmpACs.push(this.mLines[i].substring(12, 20));
        }
      }
    }
    const params = new AcDecoderParams();
    params.ac = tmpACs.join('\n');
    this.pathStack.pushPathByName('acDecoder', params);
  }

  /**
   * Display the value blocks as integers
   * (decodeValueBlocks of the Android DumpEditor).
   * Pushes the valueBlocksToInt page.
   */
  private decodeValueBlocks(): void {
    const err: number = this.checkDumpAndUpdateLines();
    if (err !== 0) {
      this.isValidDumpErrorToast(err);
      return;
    }
    // Get all Value Blocks (skip other blocks).
    const tmpVBs: string[] = [];
    let header: string = '';
    let blockCounter: number = 0;
    for (let i = 0; i < this.mLines.length; i++) {
      const line: string = this.mLines[i];
      if (line.startsWith('+')) {
        header = line;
        blockCounter = 0;
      } else {
        if (MifareUtils.isValueBlock(line)) {
          // Header.
          tmpVBs.push(header + ', Block: ' + blockCounter);
          // Value Block.
          tmpVBs.push(line);
        }
        blockCounter++;
      }
    }
    if (tmpVBs.length > 0) {
      const params = new ValueBlocksToIntParams();
      params.vb = tmpVBs;
      this.pathStack.pushPathByName('valueBlocksToInt', params);
    } else {
      // No value blocks found.
      NfcService.toast('此转储中没有值块', true);
    }
  }

  /**
   * Decode the date of manufacture (using the last 2 bytes of the
   * manufacturer block) and display the result as dialog
   * (decodeDateOfManuf of the Android DumpEditor).
   * Both of these bytes must be in BCD format (only digits, no
   * letters). The first byte (week of manufacture) must be between 1
   * and 53. The second byte (year of manufacture) must be between 0
   * and the current year.
   */
  private decodeDateOfManuf(): void {
    const err: number = this.checkDumpAndUpdateLines();
    if (err !== 0) {
      this.isValidDumpErrorToast(err);
      return;
    }
    if (this.mLines.length > 1 && this.mLines[0] === '+Sector: 0'
      && this.mLines[1].indexOf('-') === -1) {
      const weekStr: string = this.mLines[1].substring(28, 30);
      const yearStr: string = this.mLines[1].substring(30, 32);
      let messageText: string = DUMP_EDITOR_MANUF_ERROR_TEXT;
      if (/^[0-9]{2}$/.test(weekStr) && /^[0-9]{2}$/.test(yearStr)) {
        const week: number = parseInt(weekStr, 10);
        const year: number = parseInt(yearStr, 10);
        const now: number = new Date().getFullYear() % 100;
        if (year >= 0 && year <= now && week >= 1 && week <= 53) {
          // Calculate the date of manufacture (week starts at the
          // first day of the week containing Jan 1 of the year).
          const jan1: Date = new Date(2000 + year, 0, 1);
          const start: Date =
            new Date(2000 + year, 0, 1 - jan1.getDay() + (week - 1) * 7);
          const end: Date =
            new Date(start.getFullYear(), start.getMonth(), start.getDate() + 6);
          messageText = '该标签制造于 '
            + dumpEditorFormatDate(start) + ' 与 ' + dumpEditorFormatDate(end) + ' 之间'
            + '\n\n（此信息可能有误。详情请参阅“帮助与信息”。）';
        }
      }
      // Show dialog.
      this.dialogCtrl = new CustomDialogController({
        builder: MctDialog({
          titleText: '制造日期',
          messageText: messageText,
          button1Text: '确定'
        }),
        alignment: DialogAlignment.Center,
        autoCancel: true,
        customStyle: true
      });
      this.dialogCtrl.open();
    } else {
      // Error. There is no block 0.
      NfcService.toast('错误：没有制造商块（块 0）', true);
    }
  }

  /** Write the currently displayed dump (writeDump of the Android DumpEditor). */
  private writeDump(): void {
    const err: number = this.checkDumpAndUpdateLines();
    if (err !== 0) {
      this.isValidDumpErrorToast(err);
      return;
    }
    const params = new WriteTagParams();
    params.dump = this.mLines;
    this.pathStack.pushPathByName('writeTag', params);
  }

  /**
   * Compare the currently displayed dump with another dump
   * (diffDump of the Android DumpEditor).
   */
  private diffDump(): void {
    const err: number = this.checkDumpAndUpdateLines();
    if (err !== 0) {
      this.isValidDumpErrorToast(err);
      return;
    }
    const params = new DiffToolParams();
    params.dump = this.mLines;
    this.pathStack.pushPathByName('diffTool', params);
  }

  /**
   * Copy all sectors as a string to the clipboard, maintaining
   * newlines between all blocks (copyAllSectorsToClipboard of the
   * Android DumpEditor).
   */
  private copyAllSectorsToClipboard(): void {
    const err: number = this.checkDumpAndUpdateLines();
    if (err !== 0) {
      this.isValidDumpErrorToast(err);
      return;
    }
    // Build the dump string from mLines.
    let dumpString: string = '';
    for (let i = 0; i < this.mLines.length; i++) {
      const line: string = this.mLines[i];
      // Skip sector headers.
      if (line.startsWith('+')) {
        continue;
      }
      // Add a newline before appending (except for the first block).
      if (dumpString.length > 0) {
        dumpString += '\n';
      }
      dumpString += line;
    }
    NfcService.copyToClipboard(dumpString, true);
  }

  /**
   * Share a dump file as stream resource (e.g. as e-mail attachment).
   * A dialog will be displayed in which the user can choose between
   * apps that are willing to handle the dump. For sharing, the dump
   * will be saved as temporary file (shareDump of the Android
   * DumpEditor).
   */
  private shareDump(): void {
    const file: string | null = this.saveDumpToTemp();
    if (file === null) {
      return;
    }
    // Share file.
    NfcService.shareTextFile(file);
  }

  /**
   * Export the dump using the importExportTool page. For exporting,
   * the dump will be saved as temporary file (exportDump of the
   * Android DumpEditor).
   */
  private exportDump(): void {
    const file: string | null = this.saveDumpToTemp();
    if (file === null) {
      return;
    }
    const params = new ImportExportToolParams();
    params.filePath = file;
    params.isDumpFile = true;
    this.pathStack.pushPathByName('importExportTool', params);
  }

  /** Open the Value Block decoder/encoder (openValueBlockTool). */
  private openValueBlockTool(): void {
    this.pathStack.pushPathByName('valueBlockTool', null);
  }

  /** Open the Access Condition decoder/encoder (openAccessConditionTool). */
  private openAccessConditionTool(): void {
    this.pathStack.pushPathByName('acTool', null);
  }

  /** Open the BCC calculator (openBccTool). */
  private openBccTool(): void {
    this.pathStack.pushPathByName('bccTool', null);
  }

  // ---------------- Back handling ----------------

  /**
   * Show a dialog in which the user can chose between "save", "don't
   * save" and "cancel", if there are unsaved changes
   * (onBackPressed of the Android DumpEditor).
   */
  private showSaveBeforeQuittingDialog(): void {
    this.dialogCtrl = new CustomDialogController({
      builder: MctDialog({
        titleText: '未保存的更改',
        messageText: '存在未保存的更改！'
          + '\n您要保存这些更改吗？',
        button1Text: '保存',
        button1Action: (checked: boolean): void => {
          // Save.
          this.closeAfterSuccessfulSave = true;
          this.saveDump();
        },
        button3Text: '取消',
        button3Action: (checked: boolean): void => {
          // Cancel. Do nothing.
        },
        button2Text: '不保存',
        button2Action: (checked: boolean): void => {
          // Don't save.
          this.pathStack.pop();
        }
      }),
      alignment: DialogAlignment.Center,
      autoCancel: true,
      customStyle: true
    });
    this.dialogCtrl.open();
  }

  // ---------------- Builders ----------------

  /** Action bar, 1:1 with the reference app: full title (truncated
   * with ellipsis only if it truly does not fit), the AOSP floppy
   * save icon (ic_menu_save) and the overflow menu, both at the right
   * edge. The reference app shows no back arrow in this bar. */
  @Builder
  dumpEditorTitleBuilder() {
    Row() {
      Text(this.navTitle)
        .fontSize(this.titleFont)
        .fontWeight(FontWeight.Bold)
        .fontColor(MctTheme.fg)
        .layoutWeight(1)
        .maxLines(1)
        .textOverflow({ overflow: TextOverflow.Ellipsis })
      Image($r('app.media.ic_save'))
        .width(32 * this.uiScale)
        .height(32 * this.uiScale)
        .fillColor(MctTheme.fg)
        .margin({ right: 14 * this.uiScale })
        .onClick(() => {
          this.saveDump();
        })
      Image($r('app.media.ic_overflow'))
        .width(24 * this.uiScale)
        .height(24 * this.uiScale)
        .fillColor(MctTheme.fg)
        .margin({ right: 10 * this.uiScale })
        .bindMenu(this.editorMenuBuilder)
    }
    .width('100%')
    .height(56 * this.uiScale)
    .padding({ left: 16 * this.uiScale })
    .alignItems(VerticalAlign.Center)
  }

  /** One colored data block line (tapping it opens the sector editor). */
  @Builder
  dumpEditorDataLine(info: DumpEditorLineInfo, sectorNumber: string) {
    Text() {
      if (info.isSectorTrailer && info.segKeyA.length > 0) {
        Span(info.segKeyA)
          .fontColor(MctTheme.LIGHT_GREEN)
        Span(info.segAc)
          .fontColor(MctTheme.ORANGE)
        Span(info.segGpb)
          .fontColor(MctTheme.fg)
        Span(info.segKeyB)
          .fontColor(MctTheme.DARK_GREEN)
      } else if (info.isUidBlock) {
        // First block (UID, manuf. data).
        Span(info.text)
          .fontColor(MctTheme.PURPLE)
      } else if (info.isValueBlock) {
        // Value block.
        Span(info.text)
          .fontColor(MctTheme.YELLOW)
      } else {
        // Just data.
        Span(info.text)
          .fontColor(MctTheme.fg)
      }
    }
    .fontSize(this.dataFont)
    .fontFamily('monospace')
    .lineHeight(this.dataLineHeight)
    .padding(0)
    .onClick(() => {
      this.startEditing(sectorNumber);
    })
  }

  /** The editor functions menu (reference app order and wording). */
  @Builder
  editorMenuBuilder() {
    Menu() {
      MenuItem({ content: '分享' })
        .onClick(() => {
          this.shareDump();
        })
      MenuItem({ content: '以ASCII查看数据' })
        .onClick(() => {
          this.showAscii();
        })
      MenuItem({ content: '解码访问控制条件' })
        .onClick(() => {
          this.showAC();
        })
      MenuItem({ content: '以整数查看数据' })
        .onClick(() => {
          this.decodeValueBlocks();
        })
      MenuItem({ content: '解码制造日期' })
        .onClick(() => {
          this.decodeDateOfManuf();
        })
      MenuItem({ content: '比较转储' })
        .onClick(() => {
          this.diffDump();
        })
      MenuItem({ content: '写转储' })
        .enabled(!NfcService.useAsEditorOnly())
        .onClick(() => {
          this.writeDump();
        })
      MenuItem({ content: '保存密钥' })
        .onClick(() => {
          this.saveKeys();
        })
      MenuItem({ content: '编/解码值块' })
        .onClick(() => {
          this.openValueBlockTool();
        })
      MenuItem({ content: '编/解码访问控制条件' })
        .onClick(() => {
          this.openAccessConditionTool();
        })
      MenuItem({ content: 'BCC计算器' })
        .onClick(() => {
          this.openBccTool();
        })
    }
  }

  // ---------------- UI ----------------

  build() {
    NavDestination() {
      Column() {
        this.dumpEditorTitleBuilder()
        Scroll() {
          Column() {
            ForEach(this.sectorGroups,
              (group: DumpEditorSectorGroup): void => {
                Column() {
                  if (group.headerIndex >= 0
                    && group.headerIndex < this.lineInfos.length) {
                    // Sector header.
                    Text(this.lineInfos[group.headerIndex].text)
                      .fontSize(this.headerFont)
                      .fontColor(MctTheme.accent)
                      .lineHeight(this.dataLineHeight)
                      .margin({ bottom: this.headerGap })
                  }
                  if (group.errorIndex >= 0
                    && group.errorIndex < this.lineInfos.length) {
                    // Error line (sector that could not be read).
                    Text(this.lineInfos[group.errorIndex].text)
                      .fontSize(this.dataFont)
                      .fontColor(MctTheme.RED)
                      .lineHeight(this.dataLineHeight)
                      .padding(0)
                  } else if (this.editKey === group.sectorNumber) {
                    // Sector data is edited inline (Android: one
                    // multi-line EditText per sector).
                    TextArea({ text: this.editText, placeholder: '' })
                      .width(this.dataWidth)
                      .height(Math.max(1, this.editText.split('\n').length)
                        * this.dataLineHeight + 8)
                      .fontSize(this.dataFont)
                      .fontFamily('monospace')
                      .lineHeight(this.dataLineHeight)
                      .fontColor(MctTheme.fg)
                      .caretColor(MctTheme.accent)
                      .backgroundColor(Color.Transparent)
                      .padding(0)
                      .defaultFocus(true)
                      .onChange((value: string): void => {
                        // Any change marks the dump as changed
                        // (Android TextWatcher parity).
                        this.editText = value;
                        this.editDirty = true;
                        this.dumpChanged = true;
                      })
                      .onBlur(() => {
                        this.commitPendingEdit();
                      })
                  } else {
                    // Sector data (editable by tapping it).
                    Column() {
                      ForEach(group.dataIndexes,
                        (idx: number): void => {
                          this.dumpEditorDataLine(this.lineInfos[idx],
                            group.sectorNumber)
                        },
                        (idx: number): string => 'd' + idx.toString())
                    }
                    .constraintSize({ minWidth: this.dataWidth })
                    .padding({ bottom: 4 * this.uiScale })
                    .border({
                      width: { bottom: 1 },
                      color: MctTheme.fgSecondary
                    })
                  }
                }
                .alignItems(HorizontalAlign.Start)
                .margin({ bottom: this.groupGap })
              },
              (group: DumpEditorSectorGroup): string =>
                group.sectorNumber + '@' + this.groupsVersion.toString())
          }
          .width('100%')
          .alignItems(HorizontalAlign.Center)
          .padding({ bottom: 8 })
        }
        .layoutWeight(1)
        .width('100%')
        .align(Alignment.Top)
        .scrollBar(BarState.Auto)

        // Caption (activity_dump_editor.xml): title line with the
        // "Update Colors" link and the color legend (reference app
        // wording).
        Column() {
          Text() {
            Span('图例: ')
              .fontColor(MctTheme.fgSecondary)
            Span('(更新配色)')
              .fontColor(MctTheme.accent)
              .decoration({ type: TextDecorationType.Underline })
          }
          .fontSize(this.captionFont)
          .width('100%')
          .textAlign(TextAlign.Start)
          .onClick(() => {
            this.onUpdateColors();
          })

          Text() {
            Span('UID & 厂家信息')
              .fontColor(MctTheme.PURPLE)
            Span(' | ')
              .fontColor(MctTheme.fg)
            Span('值块')
              .fontColor(MctTheme.YELLOW)
            Span(' | ')
              .fontColor(MctTheme.fg)
            Span('密钥A')
              .fontColor(MctTheme.LIGHT_GREEN)
            Span(' | ')
              .fontColor(MctTheme.fg)
            Span('密钥B')
              .fontColor(MctTheme.DARK_GREEN)
            Span(' | ')
              .fontColor(MctTheme.fg)
            Span('访问控制')
              .fontColor(MctTheme.ORANGE)
          }
          .fontSize(this.captionFont)
          .width('100%')
          .textAlign(TextAlign.Start)
        }
        .width('100%')
        .padding({
          left: 5 * this.uiScale,
          right: 5 * this.uiScale,
          bottom: 5 * this.uiScale
        })
      }
      .width('100%')
      .height('100%')
      .backgroundColor(MctTheme.bg)
    }
    .hideTitleBar(true)
    .backgroundColor(MctTheme.bg)
    .onReady((ctx: NavDestinationContext) => {
      this.pathStack = ctx.pathStack;
      const p: DumpEditorParams =
        (ctx.pathInfo.param as DumpEditorParams) ?? new DumpEditorParams();
      if (p.dump !== null && p.dump !== undefined) {
        // Called from ReadTag (init editor by params).
        const uidBytes = NfcService.getUID();
        if (uidBytes !== null) {
          // Set title with UID.
          this.uid = HexUtils.bytes2Hex(uidBytes);
          this.navTitle = '转储编辑器 (UID: ' + this.uid + ')';
        }
        this.initEditor(p.dump);
      } else if (p.chosenFile.length > 0) {
        // Called from FileChooser (init editor by file).
        this.dumpName = dumpEditorBaseName(p.chosenFile);
          this.navTitle = '转储编辑器 (' + this.dumpName + ')';
        this.initEditor(MctFiles.readFileLines(p.chosenFile, false));
      }
    })
    .onShown(() => {
      // The Android DumpEditor does not register a tag listener.
    })
    .onHidden(() => {
      NfcService.setTagListener(null);
    })
    .onBackPressed(() => {
      this.commitPendingEdit();
      if (this.dumpChanged) {
        this.showSaveBeforeQuittingDialog();
        return true;
      }
      return false;
    })
  }
}

@Builder
export function DumpEditorBuilder() {
  DumpEditorPage()
}
